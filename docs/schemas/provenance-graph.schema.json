{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/schemas/provenance-graph-1.0.json",
  "title": "AgentGuard Provenance Graph",
  "type": "object",
  "required": ["schema", "scan", "summary", "nodes", "edges", "attack_paths"],
  "properties": {
    "schema": {"const": "agentguard-provenance-graph/1.0"},
    "scan": {"type": "object"},
    "summary": {"type": "object"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "subtype", "label", "source", "risk", "attributes"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["repository", "asset", "finding", "evidence"]},
          "subtype": {"type": "string"},
          "label": {"type": "string"},
          "source": {"type": "object"},
          "risk": {"type": "object"},
          "attributes": {"type": "object"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "relation", "directed", "evidence", "finding_ids", "attributes"]
      }
    },
    "attack_paths": {"type": "array", "items": {"type": "object"}},
    "ui_hints": {"type": "object"}
  }
}
